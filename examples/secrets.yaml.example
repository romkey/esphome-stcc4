# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
# ESPHome only reads secrets from a file named exactly secrets.yaml.
wifi_ssid: "example-ssid"
wifi_password: "example-password"
# A valid dummy key (base64, 32 bytes). Generate a real one per device.
api_encryption_key: "ZHVtbXktY2kta2V5LW5vdC1mb3ItcmVhbC11c2UhISE="
# At least 8 characters.
fallback_ap_password: "example-fallback"
